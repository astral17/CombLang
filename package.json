{
  "name": "comblang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace @comblang/cli && npm run build --workspace @comblang/web",
    "check": "npm run format:check && npm run typecheck && npm test",
    "cli": "npm run build --workspace @comblang/cli --silent && node apps/cli/dist/main.js",
    "dev:web": "npm run dev --workspace @comblang/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
